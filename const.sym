/* const.sym -- constants the ROM POOLS that no literal spelling reproduces.
 *
 * WHY THIS FILE EXISTS
 *
 * gcc-2.96 never pools a constant it can build with an eight-bit `mov`. So a
 * pooled small value in the ROM says the source named a SYMBOL, and the
 * disassembler resolved it back to a number. area.sym, message.sym and
 * file_table.sym each cover one identified id space; this file is for pooled
 * constants that belong to none of them.
 *
 * THE BAR FOR ADDING ONE, so this does not become a way to explain any
 * inconvenient constant:
 *
 *   1. the ROM POOLS a value an eight-bit `mov` could build, and
 *   2. no spelling of a literal reproduces both the pool AND the surrounding
 *      register allocation -- measured, with the attempts recorded in the file
 *      that needs the symbol.
 *
 * A KNOWN EXCEPTION TO THE TELL, so criterion 1 is not sufficient on its own.
 * gcc DOES pool a small constant when it is an operand of a HALFWORD
 * expression: in OvlFunc_881_200b8fc the literal 0xc is ORed with an unsigned
 * short and gcc emits `.word 12` with `ldrh r1, .L5` -- a halfword load from
 * the pool -- reproducing the ROM exactly. That function matched with plain
 * literals and needed no symbol at all.
 *
 * So before concluding a pooled small value means a symbol, check whether it
 * meets a halfword. If it does, the literal is the answer and adding an entry
 * here would be wrong.
 *
 * SECOND ATTESTED INSTANCE (batch 277), which is what makes this a rule rather
 * than an anecdote: Func_80b9470 pools 0xf at 0x080b949e -- `4b0d`, resolving to
 * `.word 0x0000000f` at 0x080b94d4, one of only two genuine small-value pool
 * words in the tree. A plain `& 0xf` on a value read by `ldrh` reproduces it
 * EXACTLY, with no relocation. No _CONST_f was added and none should be.
 * See src/non_matching/rom_b5000/80b9470.c.
 *
 * NAMED BY VALUE, asserting nothing about meaning, exactly as message.sym's own
 * header describes its unidentified entries. An absolute assignment in a linker
 * script emits no bytes, so a wrong NAME costs nothing and a wrong VALUE fails
 * `make compare` immediately.
 *
 * _CONST_2, the first entry, is the cutscene-lock bit ORed into an actor's flag
 * halfword at +0x64. The internal control is unusually good: OvlFunc_898_2008cfc
 * uses the value 2 TWICE, once as a save-flag id where the ROM writes
 * `mov r0, #2`, and once in this OR where it writes `ldr r3, =2`. Same value,
 * same function, one immediate and one pooled -- which is the tell doing its job
 * with the counterexample sitting beside it. Twelve literal spellings were
 * measured across the four functions that need it; the closest reproduces the
 * pool with the operands the other way round, or the operands with a `mov`, and
 * never both.
 */

_CONST_2 = 0x2;

/* _CONST_200 -- the inventory "locked slot" mask, bit 9.
 *
 * Func_80a40ac tests it with `ldr r3, =0x200 / and r3, r2`. gcc-2.96 never
 * pools 0x200: EIGHT spellings were probed in one file and every one emits
 * `mov r3, #128 / lsl r3, #2` --
 *
 *     int & 0x200            unsigned short & 0x200     int & m, m = 0x200
 *     (v >> 9) & 1           int & (1 << 9)             unsigned int & 0x200
 *     (v & 0x200) != 0       short & 0x200
 *
 * -- so criterion 2 is measured rather than asserted. The unsigned short and
 * short forms are worse than the others, not better: gcc shifts the value left
 * to test the bit instead of masking, and the surrounding allocation moves.
 *
 * The halfword exception recorded above does NOT apply here. The masked value
 * is widened to int by integer promotion before the AND, so there is no HImode
 * expression for gcc to pool into.
 *
 * With `(int)&_CONST_200` the pool appears exactly as the ROM has it.
 * Func_80a40ac still does not match -- it ends on a register-role swap, r2
 * against r3 -- so this entry is recorded on the pool evidence alone and not
 * on a completed function. */
_CONST_200 = 0x200;

/* _CONST_1f -- the 5-bit colour-channel mask.
 *
 * Func_80a2144 masks two channels with 0x1f and POOLS ONE OF THEM while
 * building the other with `mov r0, #0x1f` -- same value, same function, one
 * each way. That is the internal control this file's header describes for
 * _CONST_2, appearing again.
 *
 * SEVEN spellings were probed and none emits the ROM's word-sized pool load:
 *
 *     (t >> 21) & 0x1f          m = 0x1f; (t >> 21) & m     0x1f & (t >> 21)
 *     ((t >> 21) << 27) >> 27   int m = 31; (t >> 21) & m   (t >> 21) % 32
 *     unsigned short t; (t >> 5) & 0x1f
 *
 * All but the last give `mov r3, #31`. The last DOES pool it -- the halfword
 * exception above -- but as `ldrh`, a halfword load, where the ROM has `ldr`.
 * Close enough to be worth recording as a near miss and not close enough to
 * count.
 *
 * CORRECTION (batch 276): THAT OBJECTION WAS A DISASSEMBLY ARTEFACT, and this
 * entry is not needed. Thumb-1 HAS NO PC-RELATIVE `ldrh`, so gas assembles that
 * spelling to the identical halfword -- the near miss was a match all along.
 * What actually reproduces the ROM's mid-function pool and its `b`-over-pool is
 * a `(u16)` cast BEFORE the mask, which makes the mask a HImode pool entry
 * (*thumb_movhi_insn, pool_range 64) at zero extra instructions. Validated on
 * Func_80f61e8 (src/rom_f6000/rom_f6008_c_a_d.c, landed) and on Func_80f6148,
 * whose whole pool residue it closed (src/non_matching/rom_f6000/80f6148.c).
 * docs/elevation.md's matching "convincing false lead" note is corrected there
 * too. Anyone reading this paragraph should read those two files with it.
 *
 * The reference must be INLINE, `(t >> 21) & (int)&_CONST_1f`. Held in a local
 * it costs an extra callee-saved register and the function comes out worse
 * than with the literal -- 30 differing against 21.
 *
 * UNVALIDATED, AND THIS ENTRY SAYS SO. With the inline reference tryc.py
 * reports ONE difference, `=0x1f` against `=_CONST_1f`, which resolve to the
 * same value at link. `make compare` still FAILED. The screen normalises pool
 * loads and cannot see where a pool sits, so a function in this class can read
 * clean and still differ in bytes -- the same trap that caught
 * OvlFunc_919_200815c. Whatever else differs in Func_80a2144 is invisible to
 * the screen and was not found.
 *
 * The entry is kept on the seven-spelling evidence, which is real and
 * reusable. It is NOT evidence that this symbol completes any function. */
_CONST_1f = 0x1f;


/* _CONST_1 -- the value 1, pooled in a comparison against the halfword at
 * gState+0x1DA.
 *
 * CRITERION 1. Func_809b5dc emits `ldr r3, =1 / cmp r2, r3`. One is the
 * cheapest possible eight-bit `mov`, so a pool entry for it is the strongest
 * form of the symbol tell in this file's header.
 *
 * CRITERION 2, measured before this entry was added and recorded in the park
 * that used to hold the function. Reading the field into a named `short m` and
 * comparing `m == 1` does NOT pool the constant; nor does comparing the
 * dereference directly. Those were the two spellings the halfword exception
 * predicts would work, and neither does -- the exception covers a constant
 * that meets a halfword in ARITHMETIC, and a compare against an `ldrsh` result
 * is evidently not that.
 *
 * VALIDATED, unlike _CONST_1f. With `m == (int)&_CONST_1` the function matches
 * at 48 lines and `make compare` passes. It was one instruction short before.
 *
 * ON THE NAME. gState+0x1DA is read by thirteen hand-written functions and is
 * an id space of its own; it is NOT the area halfword at gState+0x1C0. Using
 * area.sym's existing `_AREA_01` would match the bytes and assert something
 * about meaning that nothing here establishes, so the value-named entry is
 * used instead, exactly as this file's header describes. If that id space is
 * ever identified, this belongs in its own .sym and should move. */
_CONST_1 = 0x1;

/* _CONST_a1 -- the first argument of __Func_8091f90 in OvlFunc_959_2009e94.
 *
 * The ROM writes `ldr r0, =0xa1 / mov r1, #0x1f`, pooling a value an eight-bit
 * `mov` builds in one instruction -- the tell this file exists for. The
 * counterexample sits four instructions away: `__Func_8091eb0(0x62, 3)` in the
 * same function writes `mov r0, #0x62`, so gcc is plainly willing to use the
 * immediate form here for a similar value.
 *
 * THE HALFWORD EXCEPTION WAS CHECKED FIRST, as this file's header requires, and
 * does not apply: a `short` prototype, a `(short)` cast and a `short` local all
 * emit `mov`, so the constant never meets a halfword.
 *
 * TEN LITERAL SPELLINGS MEASURED, all giving `mov r0, #0xa1` and leaving the
 * function one instruction and four pool bytes short:
 *
 *     0xa1                  0xa1u                 0xa0 | 1
 *     0x50 * 2 + 1          int local             short local
 *     (short) cast          short prototype       unsigned prototype
 *     no prototype
 *
 * The eleventh, a `volatile int` local, does reach the pool but spills a frame
 * slot and costs 174 differing -- it is a different construct, not a spelling.
 *
 * A NOTE ON THE RELOCATION CHECK, because it reads the wrong way here. objcmp
 * shows the REFERENCE carrying no relocation at that pool word, which elsewhere
 * in this tree refutes a symbol hypothesis. It does not refute one here: the
 * reference is a DISASSEMBLY, so a symbol in the original was baked to its
 * value before the .s was written, and the assembled reference cannot carry a
 * relocation for it either way. The symbol spelling therefore shows as a
 * PHANTOM relocation, and `make compare` is the authority -- which is exactly
 * the phantom class already recorded for linker-resolved names.
 */

_CONST_a1 = 0xa1;

/* _CONST_0 added in batch 283 for OvlFunc_970_2008430, and it COMPLETES that function:
 * byte-identical with it (1796 bytes, 694 encodings, 195 relocations), and without it
 * 2 differing encodings at size 1792 -- exactly the 4-byte missing pool word.
 *
 * THIS FILE HAD NO ZERO ENTRY BEFORE NOW, which is why the line is worth a note. The
 * ROM has `ldr r0, =0` feeding __SetDestMap where a literal gives `mov r0, #0`, and
 * docs/elevation.md's generalised tell says explicitly that it "holds all the way down
 * to zero" -- a pooled zero is a symbol.
 *
 * THE HALFWORD EXCEPTION WAS CHECKED AND DOES NOT APPLY. That exception is what makes
 * a pooled small constant a MODE artefact rather than a symbol, and batch 280 found a
 * pooled zero that was exactly that (a HImode fix whose bare literal was required --
 * see src/overlays/rom_7c7b9c/ovl_30_c_a_a_c_a_c_a_c_a_c_c_a_c.c). Here the operand is
 * an SImode CALL ARGUMENT, not a halfword or byte store, so there is no HImode path to
 * account for it.
 *
 * IN-FUNCTION CONTROL IS STRONG: this same function passes a literal 0 in many other
 * argument slots -- __Func_8092adc(...,0), __ActorMessage(1,0), __Func_8092c40(1,0),
 * __Func_8091c7c(0,0) -- and EVERY ONE reproduces as `mov rN, #0`. So the function
 * synthesises zero everywhere except at this one call, which is the discrimination this
 * file's criterion asks for.
 *
 * DIRECT PRECEDENT FOR THE SAME CALLEE: src/overlays/rom_77a7c8/ovl_30_c_c_a_c_a.c:106
 * uses `__SetDestMap((int)&_CONST_2, 0x1b)`. And unlike that entry's recorded `.word`
 * mismatch, this one folds absolute and comes out BYTE-IDENTICAL -- worth knowing that
 * the zero case is cleaner than its own precedent. */
_CONST_0 = 0x0;
