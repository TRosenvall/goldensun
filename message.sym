/* __MessageID IDs (named by value; pending semantic names).
 *
 * HEADER CORRECTED, batch 297 audit: this block was labelled "shiftable", and
 * 17 of its 49 rows are NOT shiftable -- _MSG_b33, _c7b, _c9b, _cc6, _d21, _d24,
 * _d2d, _d2e, _d38, _d42, _d4c, _e19, _e23, _e39, _fbf, _1c79, _1fbb.  The file
 * already knew (see the note below saying "roughly half the existing entries are
 * unshiftable") but the label was never changed, and a reader who trusts it
 * over-credits these rows with the pool tell they do not have.
 *
 * Shiftability is the tell for THIS section's original members only.  An
 * unshiftable row needs its own argument, and it belongs in the .c that needs
 * the symbol -- const.sym's criterion 2 says so explicitly.  The audit checked:
 * of 51 load-bearing unshiftable rows, 50 do have one there.
 *
 * Also note that six blocks below (_MSG_b20's and the five following it) were
 * each written about ONE function and have since accumulated 2-8 rows added by
 * later batches.  The block's argument does not automatically extend to a row
 * merely filed under it. */
/* _MSG_b20 -- Func_80a15f0 passes it to _Func_801e7c0 beside 0xb1c and
 * 0xb1d, which gcc pools on its own because they are not shiftable. 0xb20
 * IS shiftable (0xb2 << 4), so gcc builds it with `mov r0,#178 / lsl r0,#4`
 * and the ROM's single `ldr r0, =0xb20` is one instruction shorter -- the
 * pool tell, in the exact shape this section exists for. The two literal
 * neighbours in the same function are the internal control. */
_MSG_b20 = 0xb20;
_MSG_b33 = 0xb33;
_MSG_c7b = 0xc7b;
_MSG_c9b = 0x0c9b;
_MSG_cc6 = 0x0cc6;
