_MSG_239e = 0x239e;
_MSG_23ac = 0x23ac;
_MSG_23cc = 0x23cc;
_MSG_240d = 0x240d;

/* Two bases used by OvlFunc_959_200cbfc, which holds each in a callee-saved
 * register and derives its neighbours -- `add r5, #1` off the first, and
 * `add r0, r5, #1/2/3` off the second.  Both flow straight into __MessageID,
 * which identifies the namespace; the values are the ids the ROM pools.
 *
 * The symbol form is what makes gcc SPEND the register: written as plain int
 * constants it rematerialises each id and never keeps one alive, which is the
 * symbol-base rule in docs/elevation.md.  The ids in between (0x242f, 0x2431,
 * 0x2432, 0x2433) are reached by arithmetic and are deliberately not named. */
_MSG_242e = 0x242e;
_MSG_2430 = 0x2430;
_MSG_2440 = 0x2440;
_MSG_24db = 0x24db;
_MSG_256c = 0x256c;
_MSG_25b8 = 0x25b8;
_MSG_25dc = 0x25dc;
/* Added while elevating OvlFunc_962_200806c.  The ROM loads this base into a
 * callee-saved register and reaches the other two lines of the exchange with
 * `add r0, r5, #1` and `add r0, r5, #2`; 0x261d and 0x261e are reached by
 * arithmetic and are not named.  A plain int is constant-propagated and gcc
 * never spends the register -- the symbol address is what makes it derive. */
_MSG_261c = 0x261c;
_MSG_2624 = 0x2624;
/* _MSG_26e3 -- justification recorded in the batch-297 audit, which found this
 * was the ONLY row in any .sym with none on file anywhere.  It is load-bearing
 * (28 differing instructions without it) and it is UNSHIFTABLE, so the pool load
 * is no evidence by this project's own doctrine -- see docs/elevation.md's entry
 * on a pool word not being a tell when gcc would pool the value either way.
 * What justifies it is the shape of its single use, in
 * src/overlays/rom_7f21b8/ovl_30_c_c_a_c_a.c: the ROM takes the base into a
 * register and reaches the rest of the run by arithmetic --
 * `base = (int)(&_MSG_26e3); __MessageID(base); ... __MessageID(base + 1)` --
 * which is the recorded use_related_value shape, the same argument as _MSG_261c
 * above.  The gap was provenance, not substance; the row stands. */
_MSG_26e3 = 0x26e3;
_MSG_2880 = 0x2880;
_MSG_28be = 0x28be;
_MSG_297f = 0x297f;
_MSG_2982 = 0x2982;
_MSG_2985 = 0x2985;

/* base of a three-message prompt: the ROM holds it in a register and adds
 * 1 and 2, which only happens when the operand is a symbol address. */
_MSG_2399 = 0x2399;
_MSG_f76 = 0x0f76;

/* Added while elevating OvlFunc_885_20080dc.  Same three-message-prompt shape:
 * the ROM holds 0xf76 in r5 and reaches the other two with `add r0, r5, #1`
 * and `add r0, r5, #2`. */

/* Added while elevating OvlFunc_950_20087b0.  Same shape as the entry above:
 * the ROM loads 0x2399 into a callee-saved register and reaches the other two
 * messages with `add r0, r5, #1` and `add r0, r5, #2`.  With a plain int
 * constant gcc emits three independent pool loads and does not keep the base
 * alive at all -- rematerialising is cheaper than a push/pop pair.  It will
 * spend the register for a SYMBOL address and not for an integer, which is
 * what makes this a symbol in the original source. */

/* Added in batch 68. Func_80b2884 adds a small offset to a message id chosen by
 * a byte at iwram_3001f2c+0x3aa, and the ROM computes each offset as an
 * UNFOLDED SUBTRACTION of two pooled constants -- `ldr =0xd2e / ldr =0xd24 /
 * sub` to add ten. A compiler does not leave that unfolded, so both operands
 * were symbols.
 *
 * The namespace is identified by the CONSUMER, not the value. The result flows
 * to _Func_8017658's first argument in the already-elevated caller
 * src/rom_b0000/rom_b0070_c_c_a_b.c, and elevated code elsewhere passes
 * `(int)&_MSG_14` in that position. `_MSG_d21` was already defined in this
 * file, one of the same run.
 *
 * Named by value, asserting the namespace only -- the convention this file
 * already uses for the shiftable ids below. */

/* Added in batch 182. Func_80b595c narrates a battle result with four ids in a
 * run -- 0x810 and 0x811 inside its loop, 0x812 and 0x813 in the two tail arms.
 * The ROM pools ALL FOUR as separate `ldr rX, =` loads.
 *
 * 0x810 is the tell. It is 0x81 << 4, so gcc BUILDS it -- `mov r0, #0x81 /
 * lsl r0, #0x4` -- and pools only what it cannot build in two cheap
 * instructions. The ROM spends a pool word on it anyway, which is the same
 * argument the batch-68 note below makes: gcc will take a pool entry for a
 * SYMBOL address and not for an integer it can synthesise, so the original
 * source had a symbol here.
 *
 * The namespace is identified by the consumer: all four flow to _Func_80175a0,
 * which is the same message sink the ids above feed. */
_MSG_810 = 0x0810;
_MSG_811 = 0x0811;
_MSG_812 = 0x0812;
_MSG_813 = 0x0813;

/* Added in batch 182 alongside the block above, same argument. Func_80b1868
 * has `ldr r0, =0xad0` in front of _Func_8017658; 0xad0 is 0xad << 4, so gcc
 * synthesises it and pools only what it cannot. The pool word is the symbol
 * tell, and _Func_8017658's first argument is a message id everywhere else in
 * the tree. */
_MSG_ad0 = 0x0ad0;

/* Added in batch 182, same argument as _MSG_810 and _MSG_ad0 above.
 * Func_80b3284 (the inn) holds 0xd1c in a callee-saved register and reaches
 * 0xd1d..0xd20 with `add r0, #K`. With a plain integer gcc folds each site to
 * its own `ldr r0, =0xd1f`, loses the high register entirely and the push list
 * changes; it will spend a callee-saved register on a SYMBOL address and not on
 * an integer it can rematerialise. Consumer is Func_80b04dc, a message sink. */
_MSG_d1c = 0x0d1c;

/* Added in batch 182. OvlFunc_973_20080ec draws strings 0xc20..0xc22 into a
 * level-up box. 0xc20 is 0xc2 << 4, so a plain literal makes gcc build it with
 * `mov / lsl` where the ROM pools it -- and the knock-on is larger than the two
 * instructions: with the value in a register cse's `related_value` no longer
 * derives 0xc21 and 0xc22 from the base, so the `add r0, r5, #1` / `add r5, #2`
 * pair goes too and the r5/r6/r7 assignment rotates. Only the base is named;
 * the +1 and +2 are real arithmetic in the ROM. */
_MSG_c20 = 0x0c20;
_MSG_cf1 = 0x0cf1;

/* Added in batch 274, the same argument as _MSG_ad0, _MSG_c20 and _MSG_810 above
 * and verified the same way. All four values below are `byte << n`, so
 * thumb_shiftable_const makes gcc synthesise them with mov/lsl and it can pool
 * ONLY what it cannot build -- a pool word holding such a value therefore cannot
 * have come from a const_int at all. That is a structural impossibility rather
 * than an argument from what the ROM happened to choose, which is what separates
 * these from the pooled-constant cases that need a hoist argument.
 *
 * _MSG_c90 and _MSG_ca0 come with an internal control: Func_80b1470's neighbour
 * 0xc8f is ODD and therefore unshiftable, and it reproduces as a plain literal in
 * the same function. Same tell, same function, one pooled and one not.
 *
 * Consumers: Func_80b1470 and Func_80b153c (_MSG_c90, _MSG_ca0) reach
 * _Func_8017658, the same message sink _MSG_ad0 feeds. Func_80a5614 (_MSG_75) and
 * Func_80a56c8 (_MSG_182) reach _Func_801e7c0. _MSG_182 is additionally required by
 * Func_80b110c in rom_b0000 -- two independent functions in two ROM regions, which
 * is the strongest corroboration any entry in this file has. */
/* _MSG_50 and _MSG_51 -- the two ids Func_801b010 passes to _Func_801e7c0, the message
 * sink this file already names four times (see _MSG_b20, _MSG_182 and the batch-276 note).
 *
 * THE TELL IS STRUCTURAL AND ALREADY VERIFIED CORPUS-WIDE.  gcc-2.96 never pools an SImode
 * constant it can build with a single `mov` -- imm8 covers 0..255 -- and a scan of every
 * tracked .s bearing gcc's banner for an `ldr rX, .Lnn` whose pool word is a plain decimal
 * 1-255 gives ZERO hits in 4,282 files (measured in batch 291 for _MSG_66).  The ROM has
 * `ldr r0, =0x51` and `ldr r0, =0x50` anyway, into r0, the first argument.
 *
 * MEASURED BOTH WAYS.  As literals the function is 142 encodings against the ROM's 144 and
 * 304 bytes against 312 -- the residue is exactly the two MISSING POOL WORDS, not a code
 * difference.  As `(int)&_MSG_50` / `(int)&_MSG_51` the instruction stream is identical and
 * the only objcmp difference is the pool words carrying relocation placeholders, which the
 * link resolves.  So they COMPLETE the function, which is the bar.
 *
 * NAMESPACE BY CONSUMER, NOT BY VALUE: 0x50 and 0x51 also exist as _FILE_50/_FILE_51 and
 * _AREA_50/_AREA_51, so the bytes cannot decide.  _Func_801e7c0's first argument is a
 * message id everywhere else in the tree.
 *
 * A CAUTION FROM THE SAME BATCH THAT DOES NOT APPLY HERE, recorded so the two are not
 * confused: a pooled small constant is NOT symbol evidence when the SAME constant appears
 * both pooled and mov-ed within one function -- that is reload rematerialising a REG_EQUIV
 * pseudo, and an agent nearly filed a .sym row on it before the evidence dissolved.  Neither
 * of these two ids appears as a `mov` anywhere in this function. */
/* _MSG_cae .. _MSG_cb4 -- a seven-id run in Func_80b1f4c, all reaching Func_80b0574.
 * Worth 66 differing -> 0: they ARE the function, which is the "completes it" half of the bar.
 *
 * THE IN-FUNCTION CONTROL IS FOUR-FOLD AND IT IS THE STRONGEST IN THIS FILE.  The same
 * function, in the same run, into the same sink, also uses 0xcab, 0xcac, 0xcb5 and 0xcb6 --
 * and each of those four reproduces BYTE-EXACT AS A PLAIN LITERAL, measured by dropping each
 * one individually.  So this is not "pooled constants look like symbols"; it is eleven ids
 * side by side where exactly seven need to be symbols and four provably must not.
 *
 * TWO MECHANISMS, both impossibility arguments rather than preferences, and both verified in
 * the compiler source in the container:
 *
 *   1. 0xcb0 is shiftable (0xcb << 4), so as a literal gcc emits `mov r5,#0xcb / lsl r5,#4`
 *      where the ROM pools it.  That is this file's existing argument, and the other ten ids
 *      are unshiftable and pool either way.
 *
 *   2. THE OTHER SIX ARE AN IF-CONVERSION GATE.  ifcvt.c's noce_try_store_flag_constants
 *      opens with `GET_CODE (if_info->a) == CONST_INT && GET_CODE (if_info->b) == CONST_INT`,
 *      so a SYMBOL_REF in either arm bails it out.  Two things ride on that gate: 0xcae and
 *      0xcaf have `diff == 1`, and ARM's STORE_FLAG_VALUE is 1 (arm.h:2516), so the test
 *      `diff == STORE_FLAG_VALUE` fires and gcc rewrites the arm as `0xcae + (flag != 0)`,
 *      emitting a neg/orr/lsr #31/add idiom the ROM does not have; and the same gate blocks a
 *      speculation that hoists each chain arm's constant load above its own test and inverts
 *      the branch, one instruction shorter per arm than the ROM.
 *
 *      THE INTERNAL CONTROL IS ARITHMETIC: the function's other three constant pairs have
 *      `diff == 2`, fall off that chain under STORE_FLAG_VALUE == 1, and keep the ROM's
 *      branches -- which is exactly why those ids stay literals.
 *
 * NO FLAG REACHES IT, and this was checked rather than assumed: there is no
 * -fno-if-conversion in gcc-2.96.  The string appears twice in toplev.c and BOTH are comments
 * (lines 2872 and 3230); the calls there are unguarded, and no "if-conversion" entry exists in
 * the f_options table.  Measured alternatives: -fno-thread-jumps 66, -fno-cse-follow-jumps 66,
 * -fno-expensive-optimizations 82, -fno-gcse 117, -fno-schedule-insns2 worse and it does not
 * remove the idiom. */
_MSG_cae = 0x0cae;
_MSG_caf = 0x0caf;
_MSG_cb0 = 0x0cb0;
_MSG_cb1 = 0x0cb1;
_MSG_cb2 = 0x0cb2;
_MSG_cb3 = 0x0cb3;
_MSG_cb4 = 0x0cb4;

_MSG_50  = 0x0050;
_MSG_51  = 0x0051;

_MSG_75  = 0x0075;
_MSG_182 = 0x0182;
/* _MSG_af7 -- Func_80a9598 (batch 287) uses it as `m`, then `m + 1`, beside the
 * already-admitted _MSG_182 in the same function. As a CONST_INT the `ldr r5,=0xaf7`
 * is hoisted above the preceding call by sched2 (a constant set after reload has no
 * dependence on the call); as a symbol it stays. Four literal spellings tie at 8-9
 * differing; with the symbol the function is byte-identical. Named by value. */
_MSG_af7 = 0x0af7;
_MSG_c90 = 0x0c90;
_MSG_ca0 = 0x0ca0;

/* _MSG_66 -- the base of the eight starting-PC name strings (0x66..0x6d), read by
 * ResetPCs as `_DecompressString2(base + i, buf)` for i in 0..7.
 *
 * THE CONTROL HERE IS CORPUS-WIDE AND STRUCTURAL, not a judgement about which
 * spelling looked better. gcc-2.96 never pools an SImode constant it can build with
 * a single `mov`: imm8 covers 0..255, so a bare 0x66 is always materialised inline.
 * Scanning every tracked .s bearing gcc's banner for an `ldr rX, .Lnn` whose pool
 * word is a plain decimal 1-255 gives ZERO hits in 4,282 files. The ROM nonetheless
 * pools it (`ldr r0, =0x66 / add r0, r6, r0`), so the value in the C cannot have
 * been a literal -- only a symbol, resolved by the linker, reaches that encoding.
 *
 * IN-FUNCTION CONTROL, three ways, all matching gcc's rules exactly: the same
 * function's 0x1ff pools (over imm8), 0x4000 builds as `mov #128 / lsl #7`
 * (shiftable), and 0 pools as a HImode store constant. Only 0x66 is a mov-able
 * literal the ROM pools anyway.
 *
 * THE NAMESPACE IS DECIDED BY USE, NOT BY BYTES: 0x66 also exists as _AREA_66 and
 * _FILE_66, so the value alone cannot choose. area.sym's space is the halfword at
 * gState+0x1C0 that 61 functions COMPARE; this value is never compared, it is added
 * to an index and passed as the first argument of _DecompressString2 -- whose
 * parameter is already named `msg` in the landed
 * src/rom_b5000/rom_b5a0c_c_c_a_a_a_a_a_b.c. That is the same base-plus-index shape
 * the shiftable-id bases above cover. */
_MSG_66  = 0x0066;

/* _MSG_2930 -- base of a nine-message run in OvlFunc_971_2008b94, held in r6 for the
 * whole function.
 *
 * THE INTERNAL CONTROL IS AN ENCODING LIMIT, AND IT IS EXACT.  The ROM derives EIGHT
 * ids off the base as `add r0, r6, #K` for K in 1..7 (plus the bare r6), and reaches
 * the NINTH -- 0xd past the base -- as its own `ldr r0, =0x293d`, in the same
 * function, feeding the same __MessageID.  Thumb's `add rd, rn, #imm3` encodes only
 * 0..7, so every id the short form can reach IS derived and the one id it cannot
 * reach is pooled.  That is precisely what a symbol base predicts and what a plain
 * integer cannot produce: use_related_value (cse.c:1637) fires for a CONST and never
 * for a bare CONST_INT.
 *
 * Measured both ways: as `m = 0x2930;` the function is 177 encodings of 175 differing
 * at 180 instructions and 492 bytes against the ROM's 468 -- five extra instructions
 * and 24 extra bytes, because each id becomes its own constant.  As
 * `m = (int)&_MSG_2930;` it is ONE encoding of 175, and that one is the pool word
 * itself, which the link resolves. */
_MSG_2930 = 0x2930;

/* Added in batch 276 for Func_80a6a98, which reaches _Func_801e7c0 -- the same
 * message sink _MSG_75 and _MSG_182 feed from the neighbouring Func_80a5614 and
 * Func_80a56c8.
 *
 * NOTE WHICH ARGUMENT THIS RESTS ON, because it is NOT the shiftability one that
 * batch 274's four entries rest on. 0x53a is odd-but-one (0x53a >> 1 = 0x29d,
 * still over eight bits), so thumb_shiftable_const FAILS and gcc pools it either
 * way. The pool load is therefore no evidence at all here. That puts this entry
 * with the older majority of this file rather than with the batch-274 group.
 *
 * WHAT IS THE EVIDENCE IS THE REGISTER THE POOLED WORD LANDS IN, and the mechanism
 * is a pass boundary. A CONST_INT is materialised by RELOAD, immediately before its
 * user, so it takes whatever register reload has free -- here r2, just freed by
 * `and r0, r2` -- and sched2 cannot then hoist the load above the `and`. A
 * SYMBOL_REF is a real pseudo allocated at greg time, gets r3, and the ROM's
 * `ldr r0,=0x1ff / ldr r3,=0x53a / and / add r0,r3 / ldr r1,[r7,#0x2c] / mov r2,#0
 * / mov r3,#0` falls out whole. Measured: 8 differing with the literal, 1 (the
 * value alone) with the symbol, and FOUR literal spellings tie at 8 -- both operand
 * orders, a named `int base` hoisted before the `if`, and the callee redeclared to
 * return int. So it is not a spelling that is missing.
 *
 * Corroboration: Func_80a63e4, in the other half of this stem, pools the same
 * 0x53a into the same _Func_801e7c0.
 *
 * THE COROLLARY IS A CORRECTION TO MY OWN BATCH-275 NOTE. I withheld _MSG_b24
 * there on the ground that 0xb24 is not shiftable and so "fails the convention".
 * That reasoning was wrong: shiftability is one sufficient argument in this file,
 * not the entry criterion, and roughly half the existing entries (_MSG_cf1,
 * _MSG_c7b, _MSG_b33, _MSG_1c79, _MSG_22a3 ...) are unshiftable. _MSG_b24 is still
 * NOT added, because its function is parked and nobody has run the register
 * measurement above against it -- which is the test it actually has to pass. */
_MSG_53a = 0x053a;

/* Added in batch 278 for OvlFunc_884_2008248, a cutscene that reaches __MessageID
 * three times as a BASE PLUS ARITHMETIC -- `m`, `m + 3`, `m + 4`. That is the shape
 * _MSG_810/811/812/813 and _MSG_c20 already describe ("only the base is named; the
 * +1 and +2 are real arithmetic in the ROM"), and it is why only 0x1197 is named
 * here.
 *
 * NOT the shiftability argument: 0x1197 is odd, so gcc pools it either way and the
 * pool load is no evidence by itself. This is the register/length class, and on this
 * function the evidence is unusually strong -- STRONGER than the pooled-register
 * argument that _MSG_53a rests on:
 *
 *   with the literal, the function comes out a DIFFERENT LENGTH. Every relocation
 *   offset after the first __MessageID shifts by two, so the literal is not "a few
 *   encodings off", it is structurally wrong.
 *
 *   with the symbol, 140 encodings against the ROM's 140, every relocation identical,
 *   and ONE remaining difference: the pool word, ref 0x00001197 against our 0x00000000
 *   placeholder, which this assignment fills.
 *
 * AND IT REPLACES SCAFFOLDING RATHER THAN MERELY IMPROVING A COUNT. The alternative
 * that reaches the same bytes is `register int m __asm__("r5")` -- a pin, and a
 * fakematch row. A pin asserts nothing about the original source; a message base is
 * what the original plainly had. This entry is added on the batch-272 rule that an
 * entry is worth adding when it COMPLETES a function, which this one does, where
 * _MSG_2080 / _SIZE_80f0024 / _TBL_7a828 remain deliberately unadded because they do
 * not. */
_MSG_1197 = 0x1197;

/* Added in batch 279 for Func_80b2328, and it is the SAME SHAPE AND SAME MODULE as
 * _MSG_d1c above -- read the two together. That entry records: "Func_80b3284 (the
 * inn) holds 0xd1c in a callee-saved register and reaches 0xd1d..0xd20 with
 * `add r0, #K`. With a plain integer gcc folds each site to its own
 * `ldr r0, =0xd1f`, loses the high register entirely and the push list changes; it
 * will spend a callee-saved register on a SYMBOL address and not on an integer it
 * can rematerialise."
 *
 * Func_80b2328 does exactly that with 0xcbe, held in r11 and reaching 0xcbf / 0xcc0
 * / 0xcc1 by `add r0, #K`, and that one register decision is what forces `slot` to
 * the stack at sp+0xc -- every other difference (141 encodings) cascades from it.
 *
 * NOT the shiftability argument: 0xcbe is 0x65f << 1 and 0x65f exceeds eight bits,
 * so gcc pools it either way.
 *
 * THE PASS TRACE IS ON FILE, which is stronger than the usual measurement for this
 * class. With a named `int msg = 0xcbe`, `.03.cse` ALREADY emits the ROM's shape --
 * `(set (reg 92) (plus (reg/v 41) (const_int 1)))` carrying `REG_EQUAL 3263`,
 * because cse1 keeps the `plus` as cheaper. `.07.gcse` then undoes it:
 * "CONST-PROP: Replacing reg 41 in insn 229 with constant (const_int 3262)", and
 * again at insns 273 and 354, because cprop_insn skips only uses in the SAME basic
 * block as the def. With bare literals the relation never forms at all -- `.03.cse`
 * shows four independent (set (reg) (const_int)).
 *
 * So the integer route is destroyed by gcse specifically, and the alternative to
 * this entry was a -fno-gcse Makefile rule PLUS rewriting the array accesses as
 * named offsets to replace the global CSE that flag removes. This entry is the
 * cheaper and more honest of the two, and it completes the function: 177 encodings
 * against 177 with one pool word left, which this assignment fills. */
_MSG_cbe = 0x0cbe;

/* Added in batch 279 for DataTransferMenu, and IT RESTS ON A NEW FORM OF THE TELL:
 * A DUPLICATE POOL WORD. Worth reading, because tools/pool.py and friends key on
 * shiftability and would never flag this one -- 0xc76 is unshiftable, so a pooled
 * literal looks identical to a pooled symbol at the instruction.
 *
 * DataTransferMenu's pool is SEVEN words at 0x08028d58 holding SIX distinct values,
 * and the repeated one is 0xc76 (verified by decoding baserom.gba directly at
 * landing, not taken on report):
 *
 *     0x08028d58  0x03001f38
 *     0x08028d5c  0x00000c76   <- referenced from two StartTask priority sites
 *     0x08028d60  0x08028aa9
 *     0x08028d64  0x0000ffff
 *     0x08028d68  0x00000c77
 *     0x08028d6c  0x08028b81
 *     0x08028d70  0x00000c76   <- referenced only from DrawSmallText's id
 *
 * Eleven `ldr rN,[pc,#imm]` references resolve to those seven words, so every OTHER
 * value is deduplicated across its references. `force_const_mem` deduplicates SImode
 * const_int per function, so TWO WORDS FOR ONE VALUE MEANS THE TWO OPERANDS ARE
 * DIFFERENT OBJECTS -- one a const_int, one a SYMBOL_REF. That is a structural
 * impossibility argument of the same kind as the `byte << n` one, not an argument
 * from what the ROM happened to choose.
 *
 * All seven are SImode (the last reference is 140 bytes away, far past movhi's
 * 64-byte pool_range) and they sort by first-reference address, so it is one
 * minipool rather than two.
 *
 * WHICH OF THE TWO IS THE SYMBOL IS SETTLED INDEPENDENTLY: the StartTask side is
 * already landed as a plain literal in src/rom_15000/rom_23178_a_a_a_a_c_b.c
 * (`StartTask(Func_8028194, 0xc76)`), so the DrawSmallText id is the symbol. Nearest
 * named neighbour is _MSG_c7b at the top of this file.
 *
 * VALIDATED: the function is 150 encodings against the ROM's 150 with every one of
 * the ROM's 30 relocations present, and the single remaining difference is that pool
 * word, which this assignment fills. */
_MSG_c76 = 0xc76;

/* Added in batch 280 for OvlFunc_896_2008390 and OvlFunc_896_20086f4, which reach
 * __Func_801776c and __MessageID with a base and `base - 1` / `base - 2`. Neither value
 * is shiftable, so the pool load alone proves nothing -- but this pair comes with an
 * INTERNAL CONTROL and a MECHANISM, which is more than this class usually gets.
 *
 * THE CONTROL: the third function landed alongside them, OvlFunc_918_200869c, needs the
 * IDENTICAL technique for the same shape, and its symbol `_AREA_2d` ALREADY EXISTS in
 * area.sym:237. With it that function is exact; spelling it as a bare 0x2d gives
 * `movs r0, #45`, 246 encodings against 247, and the pool word gone. So the shape is
 * validated by a pre-existing entry in the same group of four functions.
 *
 * THE MECHANISM, read out of `.23.sched2` and worth recording because docs/elevation.md
 * states this effect without explaining it ("a pool load of a SYMBOL is not hoisted,
 * where a pool load of an int constant is"):
 *
 *   with a const_int, the pool load carries NO dependence on the preceding call, so it
 *   is ready at the top of the block and wins on priority (83 against 82);
 *   with a SYMBOL_REF, the pool load BECOMES A DEPENDENT OF THE CALL and cannot move
 *   above it -- the call's dependence list gains the load's insn.
 *
 * And the priority tie is structurally unbreakable in C:
 *     priority(mov r1,#1) = 1 + priority(call) = 2 + priority(mov r0,r5)
 *     priority(ldr)       = cost(2) + priority(mov r0,r5)
 * -- always equal, with the load then winning the dependent-count tie-break. So the
 * symbol is not a preference here, it is the only spelling that reproduces the ROM.
 *
 * Measured: as a const_int, 2 aligned differing instructions and no spelling moves it --
 * every pin permutation, unpinning either call, an inner scope for the local, sharing it
 * with a neighbour, a bare-literal pair, and -fno-schedule-insns2 (110 differing) all
 * fail. As a symbol, the single remaining difference is the pool word, which these
 * assignments fill. */
_MSG_1075 = 0x1075;
_MSG_1076 = 0x1076;

/* Added in batch 280 for OvlFunc_899_2009ba0. Same criterion as _MSG_2624 and _MSG_2399
 * above: the ROM holds the base in a callee-saved register and reaches the next id as
 * `add r0, r5, #4`, where a literal -- or a plain local -- folds to TWO pool loads and
 * loses the held register. Not a new class.
 *
 * ONLY THE BASE IS NAMED. 0x129f in the same function stays a bare literal, which is the
 * same split _MSG_c20's entry describes ("the +1 and +2 are real arithmetic in the ROM").
 *
 * A NOTE ON VERIFYING THIS CLASS, worth having: objcmp ASSEMBLES THE CANDIDATE DIRECTLY,
 * so it cannot see a linker-script definition -- the bind-mount trick docs/elevation.md
 * records for `tryc` does not carry over. The equivalent for the authority tool is a
 * top-level `__asm__(".equ _MSG_1299, 0x1299");` in the candidate, which resolves the pool
 * word identically. With that shim the function is exact at 281 encodings; without it the
 * sole difference is `ldr r5, =0x1299` against `ldr r5, =_MSG_1299`. */
_MSG_1299 = 0x1299;

/* _MSG_2644 and _MSG_920 -- ADMITTED IN BATCH 295, having been withheld in batch 280.
 *
 * The note below records that batch 280 withheld _MSG_2644, _MSG_920 and _MSG_970 for one
 * reason only: none of them COMPLETED its function.  Two of the three now do.  With these
 * lines OvlFunc_881_200a8e8 is byte-identical at 972 bytes / 381 encodings / 90 relocations
 * and Func_808e680 at 748 bytes / 311 encodings / 51 relocations; without them each file has
 * exactly one differing pool word and its relocation and nothing else.
 *
 * This is the disposition batch 282 already set for _MSG_820: a symbol whose evidence was
 * always good and whose function was not yet closed is admitted when the function closes, not
 * re-argued.  _MSG_970 stays withheld -- its function is still open.
 *
 * What closed the two functions was NOT the symbol: each had a callee declared `extern void`
 * that this tree DEFINES as `int` (Func_8096b28 at src/rom_8a000/rom_944ec_a_c_c_a_b.c:16 and
 * Func_80a10d0 at src/rom_a1000/rom_a1050_c_a_b.c:4), and in both cases a sibling file in the
 * same directory already documented that lever. */
_MSG_920  = 0x0920;
_MSG_2644 = 0x2644;

/* Added in batch 281 for Func_80b2b10, and it COMPLETES both that function and the
 * whole of asm/rom_b0000/rom_b0070_c_c_a_c_c_a_a.s -- which is the bar batch 280's
 * three withheld candidates (_MSG_2644, _MSG_920, _MSG_970) each failed. With this
 * line the file is byte-identical at 1024/1024 bytes with relocations identical;
 * without it Func_80b2b10 never reaches exact, because two independent pool loads
 * appear AND the r8/r9/r10 register roles rotate.
 *
 * THE ARITHMETIC IS THE ESTABLISHED ONE. The ROM holds 0xd27 in callee-saved r8 and
 * reaches 0xd28/0xd29/0xd2a/0xd2b as `mov r0, r8 / add r0, #1`, `#2`, `#3`, `#4`.
 * With a plain integer gcc folds each site to its own `ldr r0, =0xd29` -- cse's
 * related_value no longer derives the neighbours from a base it did not keep. That
 * is verbatim _MSG_c20's recorded mechanism ("the `add r0, r5, #1` / `add r5, #2`
 * pair goes too") and _MSG_d1c's ("holds 0xd1c in a callee-saved register and
 * reaches 0xd1d..0xd20 with `add r0, #K`").
 *
 * THE IN-FUNCTION CONTROL IS PRESENT AND IT IS THE RIGHT KIND. 0xd26 appears TWICE
 * in the same function as a plain `ldr r0, =0xd26` and reproduces byte-exact as a
 * bare literal. So message ids in this function are pooled literals in general, and
 * 0xd27 is distinguished ONLY by the `+K` arithmetic -- which is precisely the
 * discrimination this file's criterion asks for, rather than shiftability.
 *
 * Consumers are Func_80b28d4 / Func_80b2928, the same message sinks _MSG_d1c and
 * _MSG_c20 were added for. _MSG_d24, used in the file's other function as
 * `(int)&_MSG_d24` and `(int)&_MSG_d24 + 1`, was already present and needed nothing.
 *
 * A SIBLING CANDIDATE WAS WITHHELD IN THE SAME ROUND, and the contrast is the point:
 * _MSG_cc3 = 0x0cc3 for Func_80b24e4 has the same `ldr r5, =0xcc3 / ... / add r5, #1`
 * shape and FOUR in-function controls (0xcc5, 0xc9e, 0xca6, 0xca1, all plain pool
 * literals reproducing byte-exact), so its evidence is arguably stronger than this
 * one's -- but it does NOT complete its function, which is still blocked by an
 * arithmetically unreachable global_alloc priority inversion. Evidence quality and
 * completion are separate tests and this file requires both. */
_MSG_d27 = 0x0d27;

/* Added in batch 282 for Func_80bf678, and the entry exists because a batch-281 PARK
 * WAS WRONG ABOUT ITS OWN REASON FOR WITHHOLDING. That park recorded this symbol with
 * the strongest in-function control yet seen and then declined it "because 8 encodings
 * remain ... it does not COMPLETE the function". Batch 282 closed those 8, so it DOES
 * complete the function, and on this tree's own stated criterion -- evidence AND
 * completion -- it qualifies. Measured: byte-exact with the symbol, 263 differing and
 * +1 instruction with a plain 0x820 literal.
 *
 * THE CONTROL IS THE STRONGEST ON FILE AND WAS RE-DERIVED INDEPENDENTLY. This function
 * passes SEVENTEEN message ids and 0x820 is THE ONLY SHIFTABLE ONE. The other sixteen
 * -- 0x81d, 0x81e, 0x821, 0x883, 0x886, 0x887, 0x888, 0x889, 0x88a, 0x88b, 0x88c,
 * 0x88d, 0x88e, 0x891, 0x892, 0x897 -- are all unshiftable, gcc pools each of them, and
 * ALL SIXTEEN reproduce as plain literals in the reference's exact pool order. So the
 * claim is narrow and checkable: THIS ONE CONSTANT gcc CAN BUILD and the ROM chose not
 * to. It is not "this id space wants symbols".
 *
 * THE ARITHMETIC: 0x820 == 0x82 << 4 is thumb_shiftable_const, so the K-constraint split
 * in arm.md (~line 3859) makes gcc emit `movs r0,#130 / lsls r0,r0,#4`. And
 * CONST_OK_FOR_THUMB_LETTER(...,'K') is consulted on the CONST_INT VALUE ALONE, so NO
 * SOURCE SPELLING REACHES A POOL LOAD -- which is what makes this a symbol rather than a
 * spelling problem. Same shape as _MSG_b20 (Func_80a15f0) and _MSG_810..813 (batch 182).
 *
 * A NOTE ON THE LANDED FILE, because batch 282 also found the opposite mistake: the
 * landed src/rom_b5000/rom_bbb0c_c_b.c carries NO `__asm__(".equ _MSG_820, 0x820");`
 * shim. A verification shim belongs in the scratch candidate only -- batch 281 left one
 * in a landed file alongside its area.sym line, which meant nm reported the symbol twice
 * and the .sym line was never actually exercised. */
_MSG_820 = 0x820;

/* Added in batch 285 for OvlFunc_973_20084b0, and it is the BASE-PLUS-ARITHMETIC shape
 * with the mechanism now named rather than inferred. The function reaches two message
 * ids off one running base:
 *
 *     __Func_801e7c0(id + (int)&_MSG_333, box, 0x78, 0);
 *     id += (int)&_MSG_53a;
 *
 * cse.c:1637's `use_related_value` FIRES ONLY FOR `CONST`, NEVER FOR A BARE `CONST_INT`
 * (established in batch 283), so when a ROM reaches neighbouring ids by register
 * arithmetic off a base, NO PLAIN-LITERAL SPELLING CAN PRODUCE IT. That converts this
 * family of entries from "a pattern that works" into a mechanism that must.
 *
 * IN-FUNCTION CONTROL, which is the test this file actually applies:
 *   * _MSG_53a is ALREADY ADMITTED (:256) and is used THREE LINES AWAY in the SAME
 *     function, in the same `id +=` arithmetic, at the ADJACENT pool word (ours 0x230
 *     and 0x234, the reference's own literal offsets). Declining 0x333 while keeping
 *     0x53a would be incoherent -- the same argument that admitted _AREA_32 in batch
 *     281 next to an _AREA_33 that had been in the table since batch 68.
 *   * Every other constant of similar magnitude in the function reproduces as a PLAIN
 *     LITERAL: 0x500, 0x3ff, 0x800, 0x200, 0x10f, 0x10d, 0x100.
 *   * It COMPLETES its function AND its whole .s -- both OvlFunc_973_2008214 and
 *     OvlFunc_973_20084b0 go byte-identical with it, so
 *     asm/overlays/rom_7fc720/ovl_30_c_a_c_c_c_a_a_c.s converts WHOLE.
 *
 * MEASURED, and the pair is what is decisive rather than either half: plain literals for
 * both give 4 differing encodings, _MSG_53a alone gives 26, _MSG_333 alone gives 24, and
 * both together give 0. TWO CHANGES EACH WORSE THAN THE BASELINE AND DECISIVE TOGETHER --
 * the combination-sweep lesson from batch 284's Func_80bfba4, where a park held both
 * halves of a cure on file and never crossed them.
 *
 * Not shiftability: 0x333 is odd, so gcc pools it either way and the pool load is no
 * evidence on its own. This is the register/arithmetic class.
 *
 * The landed file carries NO `.equ` shim -- verified with nm that the symbol resolves
 * exactly once, so this line is genuinely exercised. */
_MSG_333 = 0x0333;
