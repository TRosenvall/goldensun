_MSG_297f = 0x297f;
_MSG_2982 = 0x2982;
_MSG_2985 = 0x2985;

/* base of a three-message prompt: the ROM holds it in a register and adds
 * 1 and 2, which only happens when the operand is a symbol address. */
_MSG_2399 = 0x2399;
_MSG_f76 = 0x0f76;

/* Added while elevating OvlFunc_885_20080dc.  Same three-message-prompt shape:
 * the ROM holds 0xf76 in r5 and reaches the other two with `add r0, r5, #1`
 * and `add r0, r5, #2`. */

/* Added while elevating OvlFunc_950_20087b0.  Same shape as the entry above:
 * the ROM loads 0x2399 into a callee-saved register and reaches the other two
 * messages with `add r0, r5, #1` and `add r0, r5, #2`.  With a plain int
 * constant gcc emits three independent pool loads and does not keep the base
 * alive at all -- rematerialising is cheaper than a push/pop pair.  It will
 * spend the register for a SYMBOL address and not for an integer, which is
 * what makes this a symbol in the original source. */

/* Added in batch 68. Func_80b2884 adds a small offset to a message id chosen by
 * a byte at iwram_3001f2c+0x3aa, and the ROM computes each offset as an
 * UNFOLDED SUBTRACTION of two pooled constants -- `ldr =0xd2e / ldr =0xd24 /
 * sub` to add ten. A compiler does not leave that unfolded, so both operands
 * were symbols.
 *
 * The namespace is identified by the CONSUMER, not the value. The result flows
 * to _Func_8017658's first argument in the already-elevated caller
 * src/rom_b0000/rom_b0070_c_c_a_b.c, and elevated code elsewhere passes
 * `(int)&_MSG_14` in that position. `_MSG_d21` was already defined in this
 * file, one of the same run.
 *
 * Named by value, asserting the namespace only -- the convention this file
 * already uses for the shiftable ids below. */
